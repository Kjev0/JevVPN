# Systemd service unit file for the JevVPN daemon

[Unit]
Description=JevVPN daemon
Before=network-online.target
After=jevvpn-early-boot-blocking.service network.target

StartLimitBurst=5
StartLimitIntervalSec=20
RequiresMountsFor=/opt/JevVPN/resources/

[Service]
Restart=always
RestartSec=1
ExecStart=/usr/bin/mullvad-daemon -vv --disable-stdout-timestamps
Environment="MULLVAD_RESOURCE_DIR=/opt/JevVPN/resources/"

# SIGUSR1 causes the daemon to enter lockdown mode before stopping.
# Lockdown mode is cleared when the daemon is started again.
# This is used to prevent network leaks on `systemctl restart`
RestartKillSignal=SIGUSR1

[Install]
WantedBy=multi-user.target
